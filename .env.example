# Aerowing Airlines Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or credentials to source control.

# Server Port (assigned dynamically by Vercel; defaults to 8080 locally)
PORT=8080

# Database Configuration (External database for Production / Cloud deployment)
DB_URL=jdbc:mysql://127.0.0.1:3306/airline_db
DB_USERNAME=root
DB_PASSWORD=

# Google Gemini AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# JWT Authentication Secret (32+ character random string for production token verification)
JWT_SECRET=

# Allowed Frontend Origins for CORS (comma-separated if multiple, e.g. https://your-project.vercel.app)
FRONTEND_URL=
